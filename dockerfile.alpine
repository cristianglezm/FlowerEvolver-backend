# syntax=docker/dockerfile:1

FROM python:3.12-alpine3.24 AS builder
RUN apk add --no-cache build-base cmake git
COPY requirements.txt /tmp/requirements.txt
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /wheels $(grep '^flowerevolver==' /tmp/requirements.txt)

FROM python:3.12-alpine3.24 AS backend
RUN addgroup -S fe && adduser -H -S -u 101 fe -G fe
COPY --from=builder /wheels /wheels
COPY --chown=fe *.py requirements.txt .env /app/
COPY --chown=fe .devops/reset.sh .devops/entrypoint.sh /app/
COPY --chown=fe ./app /app/app/
COPY --chown=fe ./generated /app/generated/
WORKDIR /app
RUN chmod +x ./entrypoint.sh && \
     apk update && apk add --no-cache gcc musl-dev mariadb-connector-c-dev libstdc++ && rm -rf /var/cache/apk/* && \
     pip install --no-cache-dir --find-links /wheels -r requirements.txt && \
     pip install --no-cache-dir gunicorn
# the volumes below start with the content and owner of these folders
RUN mkdir -p /app/db /app/migrations /app/instance && \
    chown fe:fe /app /app/db /app/migrations /app/instance
USER fe:fe
# db is for dev mode only.
VOLUME /app/generated /app/migrations /app/db
ENV FLASK_APP=manage.py
EXPOSE 5000/tcp
ENTRYPOINT ["./entrypoint.sh"]
