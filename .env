# Defaults for development. Anything already set in the environment wins over this file
# (python-dotenv in wsgi.py/manage.py and .devops/reset.sh both follow that rule).
# MySQL (used when ENV=production). The old names HOST, DB, USER and PASSWD still work as fallbacks, but
# prefer these: USER is also your shell login and docker compose takes the shell's value over this file.
DB_HOST=localhost
DB_NAME=flowerevolver
DB_USER=fe
DB_PASSWD='passwd'
# only docker compose reads this one: the root password of the mysql container (the app never uses root)
DB_ROOT_PASSWD='root_passwd'
ENV=development
ORIGINS=*
FLOWER_LIMIT=5000
SECRET_KEY='not_really_needed'

# Kafka settings
KAFKA_ENABLED="false"
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_REQUEST_TOPIC="descRequests"
KAFKA_RESPONSE_TOPIC="descResponses"

# Redis settings
REDIS_ENABLED="false"
REDIS_URL="redis://redis:6379"

RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=10

# Security settings
#
# METRICS_API_KEY: bearer token required by GET /metrics (Authorization: Bearer <key>).
# "sk_change_key" is only the development default, use a long random value anywhere else
# (e.g. `openssl rand -hex 32`). 
# When you change it, change it in ALL of these places:
#   1. here (.env), or better, as a real environment variable / secret, which always
#      wins over this file (docker compose, `docker run -e`, the environment of a scheduler)
#   2. docker/prometheus/prometheus.yml -> scrape job `flowerevolver-backend` ->
#      authorization.credentials (it is not read from the environment, edit the file,
#      or mount a file and use `credentials_file`)
#   3. docker-compose.yml passes ${METRICS_API_KEY} to the `describe` container too, so
#      it protects describe's /metrics with the same key. FlowerEvolver-describe's own
#      stack (its .env and docker/prometheus/prometheus.yml, both `sk_change_key`) is a
#      separate copy: keep it in sync if you scrape describe from there
#   4. whatever calls /metrics by hand: curl, tests/e2e/e2e_test.py (reads the
#      METRICS_API_KEY env var, default "sk_change_key"), the nginx in fe-frontend (better: do
#      not expose /metrics through nginx at all)
#   5. README.md examples (they show `sk_change_key`, the fallback in config.py when the
#      variable is missing, so a missing key never means "open")
# The image bakes this file in (see dockerfile.*): never put a real key in a committed
# .env, inject it when the container starts.
METRICS_API_KEY="sk_change_key"
