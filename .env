HOST=localhost
DB=flowerevolver
PASSWD='passwd'
USER=user
ENV=development
ORIGINS=*
FLOWER_LIMIT=5000
SECRET_KEY='not_really_needed'

# Kafka settings
KAFKA_ENABLED="false"
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_REQUEST_TOPIC="descRequests"
KAFKA_RESPONSE_TOPIC="descResponses"

RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=10

# Security settings
METRICS_API_KEY="sk_change_key"

LD_LIBRARY_PATH=./bin:$LD_LIBRARY_PATH
